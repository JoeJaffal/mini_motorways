+using System;
+
+namespace MotorwaysSim
+{
+    public sealed partial class TrafficWorld
+    {
+        void LoadPairCurriculum(int seed, string split, string kind)
+        {
+            if (kind != "match" && kind != "mismatch" && kind != "homes" &&
+                kind != "destinations" && kind != "blue-red")
+                throw new ArgumentException("Unknown pair curriculum exercise");
+            Reset(seed, ScenarioKind.EmptyLab);
+            CustomScenarioId = ConstructionCurriculumId;
+            ConstructionExercise = "clear";
+            ConstructionReference.Clear();
+            var rng = new Random(seed);
+            bool training = split == "train";
+            var origin = new Cell(training ? rng.Next(11, 20) : rng.Next(30, 38), rng.Next(10, 19));
+            int layout = rng.Next(4);
+            int span = rng.Next(3, 7);
+            int paletteStart = training ? 0 : 3;
+            int paletteSize = training ? 3 : 2;
+            int first = rng.Next(paletteSize);
+            int difference = rng.Next(1, paletteSize);
+            int second = (first + difference) % paletteSize;
+            bool different = kind == "mismatch" || rng.Next(2) == 0 && (kind == "homes" || kind == "destinations");
+            int nearColor = kind == "blue-red" ? 0 : paletteStart + first;
+            int farColor = kind == "blue-red" ? 1 : paletteStart + (different ? second : first);
+
+            Cell AccessOffset(int orientation) => orientation == 0 ? new Cell(0,2) : orientation == 1
+                ? new Cell(1,2) : orientation == 2 ? new Cell(0,0) : new Cell(0,1);
+            int[] directions = {4, 0, 6, 2};
+            var entry = origin + AccessOffset(layout);
+            int outwardDirection = directions[layout];
+            var outward = Directions[outwardDirection];
+            var end = entry;
+            for (int i = 0; i <= span; i++) end += outward;
+            var near = kind == "homes"
+                ? SpawnBuilding(entry, nearColor, true, outwardDirection)
+                : SpawnBuilding(origin, nearColor, false, 0, layout);
+            int facingBack = (outwardDirection + 4) % 8;
+            Building far;
+            if (kind == "destinations")
+            {
+                int farLayout = Array.IndexOf(directions, facingBack);
+                var offset = AccessOffset(farLayout);
+                far = SpawnBuilding(new Cell(end.X-offset.X, end.Y-offset.Y), farColor, false, 0, farLayout);
+            }
+            else far = SpawnBuilding(end, farColor, true, facingBack);
+            if (near == null || far == null)
+                throw new InvalidOperationException("Pair curriculum building placement failed");
+            Array.Clear(Inventory, 0, Inventory.Length);
+            Inventory[0] = span - 1;
+            ConstructionEditLimit = span;
+            LastAction = "Pair curriculum reset";
+        }
+    }
+}
