+using System;
+using System.Collections.Generic;
+
+namespace MotorwaysSim
+{
+    public sealed partial class TrafficWorld
+    {
+        void LoadObstacleVariety(int seed, string split, string exercise)
+        {
+            Reset(seed, ScenarioKind.EmptyLab);
+            CustomScenarioId = ConstructionCurriculumId;
+            ConstructionExercise = exercise;
+            ConstructionReference.Clear();
+            var rng = new Random(seed);
+            int orientation = rng.Next(4);
+            int color = rng.Next(3);
+            int side = rng.Next(2) == 0 ? -1 : 1;
+            var origin = new Cell(split == "train" ? rng.Next(11, 20) : rng.Next(30, 38), rng.Next(10, 19));
+            var shop = SpawnBuilding(origin, color, false, 0, orientation);
+            if (shop == null) throw new InvalidOperationException("Obstacle destination placement failed");
+            var outward = Directions[shop.DrivewayDirection];
+            var across = new Cell(-outward.Y, outward.X);
+            var start = shop.Access + outward;
+            Cell At(int x, int y) => new Cell(start.X + x*outward.X + y*across.X,
+                                             start.Y + x*outward.Y + y*across.Y);
+            void Block(int x, int y)
+            {
+                var c = At(x, y);
+                Blocked[c.X, c.Y] = true;
+                Unzoneable[c.X, c.Y] = true;
+            }
+
+            string[] parts = exercise.Split('-');
+            bool wide = parts[1] == "wide";
+            bool warm = parts.Length >= 3 && parts[2] == "warm";
+            int surplus = parts[parts.Length - 1] == "spare" ? 2 : 0;
+            int distance = wide ? rng.Next(6, 9) : rng.Next(7, 9);
+            int center = wide ? rng.Next(3, distance-2) : rng.Next(2, distance-3);
+            int offset = wide ? 0 : rng.Next(1, 3);
+            foreach (int lane in wide ? new[] {-1, 0, 1} : new[] {0, side}) Block(center, lane);
+            if (!wide)
+                Block(center-1, 2*side);
+            var witness = new List<Cell>();
+            for (int x = distance; x >= 0; x--)
+            {
+                int lateral = wide
+                    ? Math.Max(2-Math.Abs(x-center), 0)*side
+                    : (x >= center ? Math.Min(offset, x-center-1)*side : (x == center-1 ? -side : 0));
+                witness.Add(At(x, lateral));
+            }
+            var home = SpawnBuilding(witness[0], color, true, Direction(witness[0], witness[1]));
+            if (home == null) throw new InvalidOperationException("Obstacle house placement failed");
+            Array.Clear(Inventory, 0, Inventory.Length);
+            Inventory[0] = 20;
+            int left = distance - center - 2;
+            int right = distance - center + 2;
+            int stock = 0;
+            for (int i=0; i < witness.Count-1; i++)
+            {
+                if (warm && (i < left || i >= right))
+                {
+                    if (!DrawRoad(witness[i], witness[i+1]))
+                        throw new InvalidOperationException("Obstacle warm-up stub placement failed");
+                }
+                else if (i != 0)
+                {
+                    ConstructionReference.Add(("draw", witness[i], witness[i+1]));
+                    stock++;
+                }
+            }
+            Inventory[0] = stock + surplus;
+            ConstructionEditLimit = stock + 1 + surplus;
+            LastAction = "Obstacle variety reset";
+        }
+    }
+}
