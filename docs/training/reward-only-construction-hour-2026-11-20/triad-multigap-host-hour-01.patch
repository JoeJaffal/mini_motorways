+using System;
+
+namespace MotorwaysSim
+{
+    public sealed partial class TrafficWorld
+    {
+        void LoadTriad(int seed, string split, string swap)
+        {
+            var parts = swap.Split('-');
+            int gaps = parts.Length != 2 ? 0 :
+                parts[1] == "gap" ? 1 : parts[1] == "double" ? 2 : parts[1] == "triple" ? 3 : -1;
+            swap = parts[0];
+            if (gaps < 0 || swap != "left" && swap != "right")
+                throw new ArgumentException("Unknown triad color assignment");
+            Reset(seed, ScenarioKind.EmptyLab);
+            CustomScenarioId = ConstructionCurriculumId;
+            ConstructionExercise = "clear";
+            ConstructionReference.Clear();
+            var rng = new Random(seed);
+            int orientation = rng.Next(4);
+            int color = rng.Next(3);
+            int otherColor = (color+rng.Next(1,3))%3;
+            bool training = split == "train";
+            var origin = new Cell(training ? rng.Next(11,20) : rng.Next(30,38), rng.Next(10,19));
+            int span = rng.Next(gaps == 0 ? 4 : gaps + 4, Math.Max(7, gaps + 5));
+            int lane = rng.Next(1, 3);
+            var destination = SpawnBuilding(origin, color, false, 0, orientation);
+            if (destination == null) throw new InvalidOperationException("Triad destination placement failed");
+            int reverse = (destination.DrivewayDirection+4)%8;
+            var outward = Directions[destination.DrivewayDirection];
+            var sideways = new Cell(-outward.Y, outward.X);
+            var approach = destination.Access + outward;
+            Cell At(int x,int y) => new Cell(approach.X+x*outward.X+y*sideways.X,
+                                            approach.Y+x*outward.Y+y*sideways.Y);
+            bool firstLeft = rng.Next(2) == 0;
+            foreach (int side in new[] {firstLeft ? -1 : 1, firstLeft ? 1 : -1})
+            {
+                int homeColor = (side < 0) == (swap == "left") ? color : otherColor;
+                if (SpawnBuilding(At(span,side*lane),homeColor,true,reverse) == null)
+                    throw new InvalidOperationException("Triad house placement failed");
+            }
+            Array.Clear(Inventory, 0, Inventory.Length);
+            if (gaps > 0)
+            {
+                Inventory[0] = 20;
+                int missing = rng.Next(2, span - gaps);
+                foreach (int side in new[] {-1, 1})
+                {
+                    Cell Lane(int x) => At(x, Math.Min(x, lane)*side);
+                    for (int x = 0; x < span; x++)
+                    {
+                        if (x >= missing && x < missing + gaps)
+                        {
+                            if ((side < 0) == (swap == "left"))
+                                ConstructionReference.Add(("draw", Lane(x), Lane(x+1)));
+                        }
+                        else if (!DrawRoad(Lane(x), Lane(x+1)))
+                            throw new InvalidOperationException("Triad gap branch placement failed");
+                    }
+                }
+                Inventory[0] = gaps;
+                ConstructionEditLimit = gaps;
+            }
+            else
+            {
+                Inventory[0] = span-1;
+                ConstructionEditLimit = span;
+            }
+            LastAction = "Triad reset";
+        }
+    }
+}
